APP_NAME="TR-SAT Mission Control V3"
APP_ENV=development
DATABASE_URL=sqlite:///../data/trsat_v3.sqlite
CORS_ORIGINS=http://localhost:5173
CESIUM_ION_TOKEN=
# Space-Track (Optional, Authenticated GP/TLE source)
# WARNING: Do not commit the actual .env file with your credentials!
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_CESIUM_ION_TOKEN=
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# AI Assistant Configuration
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet:beta
